---
import Base from '../../layouts/Base.astro';
import { posts } from '../../posts.js';
---
<Base title="文章"><h1>文章</h1><ul class="post-list">{posts.map(post => <li><time datetime={post.frontmatter.date}>{post.frontmatter.date}</time><h2><a href={post.url}>{post.frontmatter.title}</a></h2><p>{post.frontmatter.description}</p></li>)}</ul></Base>
