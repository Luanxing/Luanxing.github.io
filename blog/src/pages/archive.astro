---
import Base from '../layouts/Base.astro';
import { posts } from '../posts.js';
const months = [...new Set(posts.map(post => post.frontmatter.date.slice(0, 7)))];
---
<Base title="归档"><h1>归档</h1>{months.map(month => <section><h2>{month.slice(0,4)} 年 {Number(month.slice(5))} 月</h2><ul>{posts.filter(post => post.frontmatter.date.startsWith(month)).map(post => <li><a href={post.url}>{post.frontmatter.title}</a></li>)}</ul></section>)}</Base>
