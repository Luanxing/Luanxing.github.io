---
import PageLayout from "@/layouts/Base.astro";
import { getAllPosts } from "@/data/post";
import { collectionDateSort } from "@/utils/date";
const posts = (await getAllPosts()).sort(collectionDateSort);
const monthKey = (date: Date) => `${date.getUTCFullYear()}-${String(date.getUTCMonth() + 1).padStart(2, "0")}`;
const months = [...new Set(posts.map(post => monthKey(post.data.publishDate)))];
---
<PageLayout meta={{ title: "归档", alternates: [{lang: "zh-CN", href: "/archive/"}, {lang: "ja", href: "/ja/archive/"}, {lang: "x-default", href: "/archive/"}] }}><nav aria-label="页面语言" class="mb-8 flex gap-4"><a class="font-semibold underline underline-offset-4" href="/archive/" lang="zh-CN" aria-current="page">中文</a><a class="cactus-link" href="/ja/archive/" lang="ja">日本語</a></nav><h1 class="title mb-12">归档</h1>{months.map(month => <section class="mb-10"><h2 class="title mb-5 text-lg">{month.slice(0,4)} 年 {Number(month.slice(5))} 月</h2><ul class="space-y-4">{posts.filter(post => monthKey(post.data.publishDate) === month).map(post => <li><a class="cactus-link" href={`/posts/${post.id}/`}>{post.data.title}</a></li>)}</ul></section>)}</PageLayout>
