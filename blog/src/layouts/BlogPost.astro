---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getImage } from "astro:assets";

import Masthead from "@/components/blog/Masthead.astro";
import Comments from "@/components/blog/Comments.astro";
import TOC from "@/components/blog/TOC.astro";
import WebMentions from "@/components/blog/webmentions/index.astro";

import BaseLayout from "./Base.astro";

interface Props {
	post: CollectionEntry<"post"> | CollectionEntry<"postJa">;
}

const { post } = Astro.props;
const isJa = post.collection === "postJa";
const lang = isJa ? "ja" : "zh-CN";
const originalId = isJa ? post.data.translationOf : post.id;
const originalPath = `/posts/${originalId}/`;
const translation = (await getCollection("postJa")).find(entry => entry.data.translationOf === originalId && !entry.data.draft);
const japanesePath = translation ? `/ja/posts/${translation.id}/` : undefined;
const alternates = japanesePath ? [{lang: "zh-CN", href: originalPath}, {lang: "ja", href: japanesePath}, {lang: "x-default", href: originalPath}] : [];

const { ogImage, coverImage, title, description, updatedDate, publishDate } = post.data;
const cover = coverImage ? await getImage({ src: coverImage.src, width: 1200, format: "jpeg" }) : undefined;
const socialImage = cover?.src ?? (ogImage === "/icon.svg" ? undefined : ogImage ?? `/og-image/${post.id}.png`);
const articleDate = publishDate.toISOString();
const { headings, remarkPluginFrontmatter } = await render(post);
const readingTime: string = isJa ? remarkPluginFrontmatter.readingTime.replace("约 ", "約").replace(" 分钟", "分") : remarkPluginFrontmatter.readingTime;
---

<BaseLayout
	meta={{
        lang, alternates,
		articleDate,
		modifiedDate: updatedDate?.toISOString(),
		description,
		ogImage: socialImage,
		title,
	}}
>
	<article class="grow break-words" data-pagefind-body>
		<div id="blog-hero" class="mb-12"><Masthead content={post} readingTime={readingTime} /></div>
		{japanesePath && <nav class="mb-6 flex gap-4" aria-label={isJa ? "言語切り替え" : "文章语言"}><a href={originalPath} lang="zh-CN" aria-current={!isJa ? "page" : undefined}>中文</a><a href={japanesePath} lang="ja" aria-current={isJa ? "page" : undefined}>日本語</a></nav>}
        {isJa && <p class="mb-6 text-sm">中国語の原文を AI のサポートで日本語に翻訳しました。<a class="underline" href={originalPath}>中国語の原文を読む</a></p>}
        <div class="article-content">
			{!!headings.length && <TOC headings={headings} />}
			<div
				class="post-prose prose prose-sm max-w-none prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-muted prose-headings:hover:before:text-accent sm:prose-headings:before:content-['#'] sm:prose-th:before:content-none"
			>
				<slot />
				<WebMentions />
			</div>
		</div>
		<Comments path={originalPath.replace(/\/$/, "")} lang={lang} />
	</article>
	<button
		class="hover:border-link fixed end-4 bottom-8 z-90 flex h-10 w-10 translate-y-28 cursor-pointer items-center justify-center rounded-full border-2 border-transparent bg-zinc-200 text-3xl opacity-0 transition-all transition-discrete duration-300 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 sm:end-8 sm:h-12 sm:w-12 dark:bg-zinc-700"
		data-show="false"
		id="to-top-btn"
	>
		<span class="sr-only">{isJa ? "ページ上部へ" : "回到顶部"}</span>
		<svg
			aria-hidden="true"
			class="h-6 w-6"
			fill="none"
			focusable="false"
			stroke="currentColor"
			stroke-width="2"
			viewBox="0 0 24 24"
			xmlns="http://www.w3.org/2000/svg"
		>
			<path d="M4.5 15.75l7.5-7.5 7.5 7.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>
</BaseLayout>

<script>
	const scrollBtn = document.getElementById("to-top-btn") as HTMLButtonElement;
	const targetHeader = document.getElementById("blog-hero") as HTMLDivElement;

	function callback(entries: IntersectionObserverEntry[]) {
		entries.forEach((entry) => {
			// only show the scroll to top button when the heading is out of view
			scrollBtn.dataset.show = (!entry.isIntersecting).toString();
		});
	}

	scrollBtn.addEventListener("click", () => {
		document.documentElement.scrollTo({ behavior: "smooth", top: 0 });
	});

	const observer = new IntersectionObserver(callback);
	observer.observe(targetHeader);
</script>
