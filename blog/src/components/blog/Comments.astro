---
import comments from "@/config/comments.json";
interface Props { path?: string; lang?: string; }
const { path, lang = "zh-CN" } = Astro.props;
const isJa = lang === "ja";
const serverURL = comments.serverURL.trim();
if (serverURL && !serverURL.startsWith("https://")) {
  throw new Error("Waline serverURL must use HTTPS");
}
---
{serverURL && (
  <section class="comments mt-12 border-t border-dashed pt-8" aria-labelledby="comments-title" data-pagefind-ignore>
    <h2 id="comments-title" class="mb-4 text-xl font-semibold">{isJa ? "コメント" : "留言"}</h2>
    <p class="mb-4 text-sm">{isJa ? "気軽にコメントしてください。ニックネームのみ必須で、メールアドレスは任意・非公開です。" : "欢迎聊聊你的想法，填个昵称就能留言。邮箱选填，不会公开展示。"}</p>
    <button id="load-comments" class="cursor-pointer rounded border px-4 py-2" type="button">{isJa ? "コメントを読む・書く" : "查看或写留言"}</button>
    <p id="comments-status" role="status" class="mt-3 text-sm"></p>
    <div id="waline" data-server-url={serverURL} data-comment-path={path} data-lang={lang}></div>
    <noscript>请启用 JavaScript 后查看和发送留言。</noscript>
  </section>
)}
<script is:inline type="module">
  const button = document.getElementById('load-comments');
  button?.addEventListener('click', async () => {
    const container = document.getElementById('waline');
    const status = document.getElementById('comments-status');
    button.disabled = true;
    const isJa = container.dataset.lang === 'ja';
    status.textContent = isJa ? 'コメントを読み込み中…' : '正在加载评论…';
    try {
      if (!document.getElementById('waline-css')) {
        const css = document.createElement('link');
        css.id = 'waline-css';
        css.rel = 'stylesheet';
        css.href = 'https://unpkg.com/@waline/client@v3/dist/waline.css';
        document.head.append(css);
      }
      const { init } = await import('https://unpkg.com/@waline/client@v3/dist/waline.js');
      init({
        el: container,
        serverURL: container.dataset.serverUrl,
        path: container.dataset.commentPath || window.location.pathname.replace(/\/$/, ''),
        lang: isJa ? 'jp' : 'zh-CN',
        dark: 'html[data-theme="dark"]',
        login: 'enable',
        meta: ['nick', 'mail', 'link'],
        requiredMeta: ['nick'],
        pageview: false,
        comment: false,
        search: false,
        imageUploader: false,
        wordLimit: 2000,
        locale: { placeholder: isJa ? '記事を読んで思ったことなど、気軽にどうぞ。' : '这篇文章让你想到了什么？欢迎留言。' },
      });
      button.hidden = true;
      status.textContent = '';
    } catch {
      status.textContent = isJa ? 'コメントを読み込めませんでした。しばらくしてから再度お試しください。' : '评论暂时无法加载，请稍后重试。';
      button.disabled = false;
    }
  });
</script>
<style>
  .comments { font-family: Verdana, sans-serif; line-height: 1.6; }
  #waline { --waline-font-size: 16px; --waline-theme-color: var(--color-accent); --waline-text-color: var(--color-global-text); }
</style>
