---
import { WEBMENTION_PINGBACK, WEBMENTION_URL } from "astro:env/client";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";
import "@/styles/global.css";

type Props = SiteMeta;

const { lang = siteConfig.lang, alternates = [], articleDate, modifiedDate, noindex = false, description = siteConfig.description, ogImage, title } = Astro.props;

const titleSeparator = "•";
const siteTitle = Astro.url.pathname === "/" ? `${siteConfig.title} · Otto 的旅行与生活记录` : `${title} ${titleSeparator} ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = ogImage && !ogImage.endsWith(".svg") ? new URL(ogImage, Astro.site).href : undefined;
const authorURL = new URL("/about/", Astro.site).href;
const authorId = `${authorURL}#person`;
const websiteId = new URL("/#website", Astro.site).href;
const person = { "@type": "Person", "@id": authorId, name: siteConfig.author, alternateName: "一方乱行", url: authorURL };
const website = { "@type": "WebSite", "@id": websiteId, name: siteConfig.title, alternateName: "一方乱行的博客", url: Astro.site!.href, description: siteConfig.description, inLanguage: siteConfig.lang, author: { "@id": authorId } };
const page = {
 "@type": articleDate ? "BlogPosting" : Astro.url.pathname === "/about/" ? "AboutPage" : "WebPage",
 "@id": `${canonicalURL.href}#${articleDate ? "article" : "page"}`,
 url: canonicalURL.href,
 ...(articleDate ? { headline: title, datePublished: articleDate, ...(modifiedDate ? { dateModified: modifiedDate } : {}), author: { "@id": authorId }, mainEntityOfPage: canonicalURL.href } : { name: siteTitle }),
 description,
 inLanguage: lang,
 isPartOf: { "@id": websiteId },
 ...(socialImageURL ? { image: [socialImageURL] } : {}),
 ...(Astro.url.pathname === "/about/" ? { mainEntity: { "@id": authorId } } : {}),
};
const structuredData = JSON.stringify({ "@context": "https://schema.org", "@graph": [website, person, page] }).replaceAll("<", "\\u003c");
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>{siteTitle}</title>

{/* Icons */}
<link href="/icon.svg" rel="icon" type="image/svg+xml" />
{
	import.meta.env.PROD && (
		<>
			{/* Favicon & Apple Icon, Generated at build */}
			<link rel="icon" href="/favicon-32x32.png" type="image/png" />
			<link href="/icons/apple-touch-icon.png" rel="apple-touch-icon" />
			{/* Manifest */}
			<link href="/manifest.webmanifest" rel="manifest" />
		</>
	)
}

{/* Canonical URL */}
<link href={canonicalURL} rel="canonical" />
{alternates.map(item => <link rel="alternate" hreflang={item.lang} href={new URL(item.href, Astro.site)} />)}

{/* Primary Meta Tags */}
<meta content={siteTitle} name="title" />
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
{!noindex && <script type="application/ld+json" set:html={structuredData} />}

{/* Open Graph / Facebook */}
<meta content={articleDate ? "article" : "website"} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={siteConfig.title} property="og:site_name" />
<meta content={lang === "ja" ? "ja_JP" : siteConfig.ogLocale} property="og:locale" />
{socialImageURL && <meta content={socialImageURL} property="og:image" />}
{
	articleDate && (
		<>
			<meta content={authorURL} property="article:author" />
			<meta content={articleDate} property="article:published_time" />
{modifiedDate && <meta content={modifiedDate} property="article:modified_time" />}
		</>
	)
}

{/* Twitter */}
<meta content={socialImageURL ? "summary_large_image" : "summary"} property="twitter:card" />
<meta content={canonicalURL} property="twitter:url" />
<meta content={title} property="twitter:title" />
<meta content={description} property="twitter:description" />
{socialImageURL && <meta content={socialImageURL} property="twitter:image" />}

{/* Sitemap */}
<link href="/sitemap-index.xml" rel="sitemap" />

{/* RSS auto-discovery */}
<link href="/rss.xml" title="一方乱行" rel="alternate" type="application/rss+xml" />
<link href="/notes/rss.xml" title="Notes" rel="alternate" type="application/rss+xml" />

{/* Webmentions */}
{
	WEBMENTION_URL && (
		<>
			<link href={WEBMENTION_URL} rel="webmention" />
			{WEBMENTION_PINGBACK && <link href={WEBMENTION_PINGBACK} rel="pingback" />}
		</>
	)
}

<meta content={Astro.generator} name="generator" />
